import LeanEconomics.KrusellSmith.AggregateStateStationary

/-!
# When are aggregate shock and aggregate capital a sufficient state?

Milestone AK4 of `AGGREGATE_STATE_PLAN.md`.

A recursive equilibrium on `(z, K)` **represents** a sequence-state equilibrium `μ`
(`AggStateRecursiveEquilibrium.Represents`) when at every history `ω` the capital lies in the
capital set at `ω 0`, the distribution `μ ω` is one of those consistent with `(ω 0, K)`, and
households save by the `(z, K)` policy.

* **Necessity** (`Represents.kSufficient`): then the whole tree of future capital and labour is
  generated by `lawK` and `labourK` from `(ω 0, capital ω)` (`Represents.seqPrices_eq`), so
  `KSufficient` holds.
* **`kSufficient_iff_exists_represents`**: for every sequence-state equilibrium, `KSufficient`
  holds **if and only if** some recursive equilibrium on `(z, K)` represents it (sufficiency is
  `toAggStateRecursive`).

**`minMPC_smallShare_aggregateState`** (CRRA, clamped Cobb–Douglas, small capital shares, both
shock chains bounded below): the unique, continuous sequence-state equilibrium is represented by
a recursive equilibrium on `(z, K)` if and only if `KSufficient`; and then the capital sets are
compact, the law of motion of capital is continuous on them, and the law of `(z, K)` is the
unique invariant distribution on the capital sets, and it is ergodic.
-/

open MeasureTheory Topology Filter Set BoundedContinuousFunction TopologicalSpace ProbabilityTheory
open scoped ENNReal NNReal

namespace LeanEconomics

namespace KrusellSmith

variable {Z E : Type*} [Fintype Z] [Fintype E]

namespace KSModel

variable {M : KSModel Z E} {μ : History Z → ProbabilityMeasure M.AState}

namespace AggStateRecursiveEquilibrium

/-- **`R` represents the sequence-state equilibrium `μ`.** -/
def Represents (R : M.AggStateRecursiveEquilibrium)
    (μ : History Z → ProbabilityMeasure M.AState) : Prop :=
  ∀ ω : History Z, capAt μ ω ∈ R.Kset (ω 0) ∧ μ ω ∈ R.dist (ω 0) (capAt μ ω) ∧
    ∀ (a : ↥(Icc (0 : ℝ) M.assetCap)) (e : E),
      M.seqPolicy μ ω a e = R.saving (ω 0) (capAt μ ω) a e

/-- The aggregate state of `R` along a node `g` (newest first) of the tree from `(z, k)`. -/
noncomputable def stateAlong (R : M.AggStateRecursiveEquilibrium) (z : Z) (k : ℝ) :
    List Z → Z × ℝ
  | [] => (z, k)
  | z' :: g => (z', R.lawK (R.stateAlong z k g).1 (R.stateAlong z k g).2 z')

variable {R : M.AggStateRecursiveEquilibrium}

/-- Under representation, **next capital is `lawK`**. -/
theorem Represents.capAt_cons (hμ : M.IsSeqStateEquilibrium μ) (hR : R.Represents μ)
    (ω : History Z) (z' : Z) :
    capAt μ (History.cons z' ω) = R.lawK (ω 0) (capAt μ ω) z' := by
  obtain ⟨_, hν, hsav⟩ := hR ω
  have h : capAt μ (History.cons z' ω)
      = ∫ x, (M.seqPolicy μ ω x.1 x.2.idio : ℝ) ∂(μ ω : Measure M.AState) :=
    hμ.toRecursive.capital_cons ω z'
  rw [h, ← R.integral_saving hν z']
  simp only [hsav]

/-- Under representation, **labour is `labourK`**. -/
theorem Represents.labour_eq (hR : R.Represents μ) (ω : History Z) :
    (M.seqPrices μ ω []).2 = R.labourK (ω 0) (capAt μ ω) :=
  (R.labour_eq _ _ _ (hR ω).2.1).symm

theorem Represents.stateAlong_eq (hμ : M.IsSeqStateEquilibrium μ) (hR : R.Represents μ)
    (ω : History Z) : ∀ g : List Z,
      R.stateAlong (ω 0) (capAt μ ω) g = (History.prepend g ω 0, capAt μ (History.prepend g ω))
  | [] => rfl
  | z' :: g => by
    change (z', R.lawK (R.stateAlong (ω 0) (capAt μ ω) g).1
      (R.stateAlong (ω 0) (capAt μ ω) g).2 z') = _
    rw [hR.stateAlong_eq hμ ω g, ← hR.capAt_cons hμ (History.prepend g ω) z']
    rfl

/-- **The price tree is generated by `lawK` and `labourK`** from `(ω 0, capital ω)`. -/
theorem Represents.seqPrices_eq (hμ : M.IsSeqStateEquilibrium μ) (hR : R.Represents μ)
    (ω : History Z) (g : List Z) :
    M.seqPrices μ ω g = ((R.stateAlong (ω 0) (capAt μ ω) g).2,
      R.labourK (R.stateAlong (ω 0) (capAt μ ω) g).1 (R.stateAlong (ω 0) (capAt μ ω) g).2) := by
  rw [hR.stateAlong_eq hμ ω g, ← hR.labour_eq (History.prepend g ω)]
  have h := M.seqPrices_prepend μ ω g []
  rw [List.nil_append] at h
  rw [← h]
  rfl

/-- **Necessity**: a sequence-state equilibrium represented by a recursive equilibrium on `(z, K)`
satisfies `KSufficient`. -/
theorem Represents.kSufficient (hμ : M.IsSeqStateEquilibrium μ) (hR : R.Represents μ) :
    KSufficient μ := by
  intro ω ω' h0 hk
  funext g
  rw [hR.seqPrices_eq hμ ω g, hR.seqPrices_eq hμ ω' g, h0, hk]

end AggStateRecursiveEquilibrium

/-- The recursive equilibrium on `(z, K)` built from `KSufficient` represents the equilibrium. -/
theorem toAggStateRecursive_represents (hμ : M.IsSeqStateEquilibrium μ) (hS : KSufficient μ) :
    (toAggStateRecursive hμ hS).Represents μ :=
  fun ω => ⟨⟨ω, rfl, rfl⟩, ⟨ω, rfl, rfl, rfl⟩, fun a e => seqPolicy_eq_savingK hS ω a e⟩

/-- **`(z, K)` is a sufficient state if and only if a recursive equilibrium on `(z, K)`
represents the equilibrium.** -/
theorem kSufficient_iff_exists_represents (hμ : M.IsSeqStateEquilibrium μ) :
    KSufficient μ ↔ ∃ R : M.AggStateRecursiveEquilibrium, R.Represents μ :=
  ⟨fun hS => ⟨toAggStateRecursive hμ hS, toAggStateRecursive_represents hμ hS⟩,
    fun ⟨_, hR⟩ => hR.kSufficient hμ⟩

end KSModel

/-! ### The small-share economy -/

variable [Nonempty Z] [Nonempty E] (V : KSEnvironment Z E) (T : CobbDouglas Z) {γ : ℝ}
  (hγ : 0 < γ) {ε εZ : ℝ} (hε : 0 < ε) (hminor : ∀ z z' e e', ε ≤ V.idioProb z z' e e')
  (hεZ : 0 < εZ) (hminorZ : ∀ z z', εZ ≤ V.aggProb z z')
include hε hminor hεZ hminorZ

/-- **A stationary recursive equilibrium on `(z, K)` for small capital shares, exactly when
`(z, K)` is sufficient**: for CRRA, clamped Cobb–Douglas with `0 ≤ δ < 1` and
`(β (1 − δ))^{1/γ} < 1 − δ`, both shock chains bounded below and small capital shares, the unique
sequence-state equilibrium is continuous in the history; it is represented by a recursive
equilibrium on `(z, K)` if and only if `KSufficient`; and when it is, the capital sets are compact,
the law of motion of capital is continuous on them, and for the stationary law of the shock
history the law of `(z, K)` is invariant, ergodic, and the only invariant law on the capital
sets. -/
theorem minMPC_smallShare_aggregateState (hδ1 : T.depreciation < 1)
    (hgap : (V.discount * (1 - T.depreciation)) ^ (1 / γ) < 1 - T.depreciation) :
    ∃ α₀ > 0, ∀ α (h0 : 0 < α), α < α₀ → ∃ hα : α < 1,
      ∃ μ : History Z → ProbabilityMeasure (crraModel V (T.withShare α h0 hα) hγ).AState,
        (crraModel V (T.withShare α h0 hα) hγ).IsSeqStateEquilibrium μ ∧
        (∀ μ', (crraModel V (T.withShare α h0 hα) hγ).IsSeqStateEquilibrium μ' → μ' = μ) ∧
        Continuous (fun ξ : ShockPath Z => μ ξ.toHistory) ∧
        (KSModel.KSufficient μ ↔
          ∃ R : (crraModel V (T.withShare α h0 hα) hγ).AggStateRecursiveEquilibrium,
            R.Represents μ) ∧
        (KSModel.KSufficient μ →
          (∀ z, IsCompact (KSModel.Kset μ z)) ∧
          (∀ z z', ContinuousOn (fun k => KSModel.lawK μ z k z') (KSModel.Kset μ z)) ∧
          ∃ P : ProbabilityMeasure (ShockPath Z),
            ShockPath.IsInvariant V.aggProb (P : Measure (ShockPath Z)) ∧
            KSModel.IsAggInvariant μ (KSModel.aggLaw (P : Measure (ShockPath Z)) μ) ∧
            KSModel.aggLaw (P : Measure (ShockPath Z)) μ (KSModel.Kgraph μ) = 1 ∧
            (∀ B, MeasurableSet B →
              (∀ᵐ s ∂(KSModel.aggLaw (P : Measure (ShockPath Z)) μ),
                s ∈ B → KSModel.aggKernel μ s B = 1) →
              KSModel.aggLaw (P : Measure (ShockPath Z)) μ B = 0 ∨
                KSModel.aggLaw (P : Measure (ShockPath Z)) μ B = 1) ∧
            ∀ (Λ : Measure (ShockVal Z × ℝ)) [IsProbabilityMeasure Λ],
              KSModel.IsAggInvariant μ Λ → Λ (KSModel.Kgraph μ) = 1 →
              Λ = KSModel.aggLaw (P : Measure (ShockPath Z)) μ) := by
  obtain ⟨α₀, hα₀, h⟩ := minMPC_smallShare V T hγ hδ1 hgap
  refine ⟨α₀, hα₀, fun α h0 hα => ?_⟩
  obtain ⟨h1, S, hκ, hr⟩ := h α h0 hα
  refine ⟨h1, ?_⟩
  have hminor' : ∀ z z' e e', ε ≤ (crraModel V (T.withShare α h0 h1) hγ).idioProb z z' e e' :=
    hminor
  have hℓL := (T.withShare α h0 h1).labLip_nonneg
  have hRL := (T.withShare α h0 h1).abs_grossReturn_sub_le_lab
  have hwL := (T.withShare α h0 h1).abs_wage_sub_le_lab
  obtain ⟨μ, hμ⟩ := (crraModel V (T.withShare α h0 h1) hγ).exists_seqStateEquilibrium
  have hc := S.continuous_seqState hminor' hℓL hRL hwL hε hκ hr hμ
  refine ⟨μ, hμ, fun μ' hμ' => S.eq_of_rate_lt_one hκ hμ' hr hμ
      (hμ'.initMass_eq_of_minor hμ hε hminor'), hc, KSModel.kSufficient_iff_exists_represents hμ,
    fun hS => ⟨fun z => KSModel.isCompact_Kset hc z,
      fun z z' => KSModel.continuousOn_lawK hS hc z z', ?_⟩⟩
  obtain ⟨P, hP, herg⟩ := ShockPath.exists_invariant_ergodic V.aggProb V.aggProb_nonneg
    V.aggProb_sum
  have huniq := ShockPath.stationary_unique_of_minor V.aggProb_sum hεZ hminorZ
  obtain ⟨hinv, hK, herg', huniq'⟩ :=
    S.stationary_aggLaw hμ hminor' hℓL hRL hwL hε hκ hr hS huniq hP herg
  exact ⟨P, hP, hinv, hK, herg', huniq'⟩

end KrusellSmith

end LeanEconomics
