import LeanEconomics.KrusellSmith.ColemanOperator
import LeanEconomics.KrusellSmith.WageComparativeStatics
import LeanEconomics.KrusellSmith.RepAgentCash

/-!
# From the Krusell–Smith model to the Coleman operator

Milestones CO4a–CO4b of `COLEMAN_PLAN.md`.

* **`crraData`** (CO4a): the representative-agent CRRA, Cobb–Douglas economy as Coleman data —
  marginal utility `c^{-γ}`, the Cobb–Douglas return and representative cash at labour equal to the
  one efficiency level (inside the labour box), the floor `m = w̲ L`, and `β R̄ ≤ 1`.
* **`capPath`** (CO4b): the capital path on the tree of shock histories generated by a policy:
  from `k₀`, next capital is the Euler saving at the node's shock and capital. Along it the Euler
  conditions hold with tomorrow's consumption given by the policy at tomorrow's capital
  (`capPath_euler`), for the Coleman fixed point.
-/

open Set Filter Topology

namespace LeanEconomics

namespace KrusellSmith

namespace Coleman

variable {Z E : Type*} [Fintype Z] [Fintype E] [Unique E]

/-- **The representative-agent CRRA, Cobb–Douglas economy as Coleman data.** -/
noncomputable def crraData (V : KSEnvironment Z E) (T : CobbDouglas Z) {γ : ℝ} (hγ : 0 < γ)
    (hLbox : T.clampLab (V.efficiency default) = V.efficiency default)
    (hβR : V.discount * T.returnBound ≤ 1) : Data Z where
  π := V.aggProb
  π_nonneg := V.aggProb_nonneg
  π_sum := V.aggProb_sum
  β := V.discount
  β_pos := V.discount_pos
  cap := V.assetCap
  cap_pos := V.assetCap_pos
  du c := c ^ (-γ)
  du_anti _ ha _ _ hab := Real.rpow_lt_rpow_of_neg ha hab (by linarith)
  du_cont x hx := (Real.continuousAt_rpow_const x (-γ) (Or.inl (ne_of_gt hx))).continuousWithinAt
  du_pos _ hc := Real.rpow_pos_of_pos hc _
  du_inada := tendsto_rpow_neg_nhdsGT_zero (by linarith)
  R z k := T.grossReturn z k (V.efficiency default)
  R_cont z := (T.continuous_grossReturn z).comp (continuous_id.prodMk continuous_const)
  R_nonneg z k := T.grossReturn_nonneg z _ _
  R_anti z _ _ _ _ hab := T.grossReturn_anti z hab _
  Rbar := T.returnBound
  R_le z k := T.grossReturn_le z _ _
  βR_le := hβR
  y z k := T.grossReturn z k (V.efficiency default) * k
    + T.wage z k (V.efficiency default) * V.efficiency default
  y_cont z := (((T.continuous_grossReturn z).comp (continuous_id.prodMk continuous_const)).mul
    continuous_id).add (((T.continuous_wage z).comp (continuous_id.prodMk continuous_const)).mul
    continuous_const)
  y_mono z _ ha _ _ hab := T.repCash_mono z hLbox ha.1 hab
  m := T.wageLo * V.efficiency default
  m_pos := mul_pos T.wageLo_pos (V.effLo_pos.trans_le (V.effLo_le default))
  m_le_y z k hk := by
    have h1 := mul_nonneg (T.grossReturn_nonneg z k (V.efficiency default)) hk.1
    have h2 := mul_le_mul_of_nonneg_right (T.wageLo_le_wage z k (V.efficiency default))
      (V.effLo_pos.le.trans (V.effLo_le default))
    linarith

namespace Data

variable {Z : Type*} [Fintype Z] (D : Data Z)

/-- Saving at `(z, k)` against `c`, as a capital level. -/
noncomputable def savingBox (c : D.Pol) (z : Z) (k : D.Box) : D.Box :=
  ⟨D.saving c z k, (D.saving_spec c z k).1, (D.saving_spec c z k).2.1⟩

/-- **The capital path generated by a policy** on the tree of shock histories from `(z₀, k₀)`. -/
noncomputable def capPath (c : D.Pol) (z₀ : Z) (k₀ : D.Box) : List Z → D.Box
  | [] => k₀
  | _ :: h => D.savingBox c (h.headD z₀) (capPath c z₀ k₀ h)

/-- **The Euler conditions along the path of the Coleman fixed point**: at every node, saving is
the Euler root against tomorrow's consumption at tomorrow's capital. -/
theorem capPath_euler (z₀ : Z) (k₀ : D.Box) (h : List Z) :
    IsEulerRoot D.du (D.cont (OrderHom.gfp D.T) (h.headD z₀)) D.cap
      (D.y (h.headD z₀) (D.capPath (OrderHom.gfp D.T) z₀ k₀ h))
      (D.capPath (OrderHom.gfp D.T) z₀ k₀ (h.headD z₀ :: h)) :=
  D.saving_spec _ _ _

/-- At the fixed point, consumption is cash less saving. -/
theorem gfp_cons (z : Z) (k : D.Box) :
    (OrderHom.gfp D.T).1 z k = D.y z k - D.saving (OrderHom.gfp D.T) z k := by
  have hfix : D.T (OrderHom.gfp D.T) = OrderHom.gfp D.T := OrderHom.map_gfp D.T
  conv_lhs => rw [← hfix]
  rfl

end Data

end Coleman

end KrusellSmith

end LeanEconomics
