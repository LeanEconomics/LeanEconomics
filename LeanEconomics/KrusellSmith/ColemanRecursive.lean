import LeanEconomics.KrusellSmith.ColemanEquilibrium
import LeanEconomics.KrusellSmith.AggregateStateRecursive

/-!
# A recursive equilibrium on `(z, K)` for every capital share

Milestone CO5 of `COLEMAN_PLAN.md`: the representative-agent CRRA, Cobb–Douglas economy with one
idiosyncratic state, labour inside its box and `β R̄ ≤ 1`.

**`colemanRecursive`**: an `AggStateRecursiveEquilibrium` whose aggregate state is `(z, K)`, with
`K` ranging over all of `[0, ā]`:

* capital moves by the Coleman saving, `lawK z K z' = s*(z, K)`; labour is the efficiency;
* value and saving at `(z, K, a, e)` are the household's, at the prices of the Coleman capital path
  from `(z, K)`; the Bellman equation and optimality hold because the price path from the next
  node is the Coleman path from `(z', s*(z, K))` (`valueFunction_next`);
* the distributions consistent with `(z, K)` are the point mass at `K`; the representative
  household at `K` saves `s*(z, K)` (`policy_eq_saving`), so the point mass moves to the point
  mass at `lawK z K z'`.

No uniqueness and no small-share condition: existence comes from Tarski on the Coleman operator
(`ColemanOperator.lean`), optimality from Euler sufficiency (`ColemanSufficiency.lean`).
`capPath_eq_lawK`: the sequential equilibrium of CO4d is generated by this law of motion.
-/

open Set Filter Topology MeasureTheory
open LeanEconomics.StochasticDynamicProgram

namespace LeanEconomics

namespace KrusellSmith

namespace Coleman

variable {Z E : Type*} [Fintype Z] [Fintype E] [Unique E] (V : KSEnvironment Z E)
  (T : CobbDouglas Z) {γ : ℝ} (hγ : 0 < γ)
  (hLbox : T.clampLab (V.efficiency default) = V.efficiency default)
  (hβR : V.discount * T.returnBound ≤ 1)

local notation "𝒟" => crraData V T hγ hLbox hβR
local notation "𝒸" => OrderHom.gfp (Data.T (crraData V T hγ hLbox hβR))
local notation "𝕄" => crraModel V T hγ

/-- Capital as a point of the box. -/
noncomputable def kBox (k : ℝ) : (𝒟).Box :=
  projIcc 0 (𝒟).cap (𝒟).cap_pos.le k

theorem kBox_val {k : ℝ} (hk : k ∈ Icc 0 V.assetCap) :
    ((kBox V T hγ hLbox hβR k : (𝒟).Box) : ℝ) = k := by
  rw [kBox, projIcc_of_mem (𝒟).cap_pos.le (show k ∈ Icc 0 (𝒟).cap from hk)]

theorem kBox_coe (x : (𝒟).Box) : kBox V T hγ hLbox hβR (x : ℝ) = x :=
  projIcc_val _ x

/-- The prices at `(z, K)`: those of the Coleman capital path from `(z, K)`. -/
noncomputable def pricesK (z : Z) (k : ℝ) : List Z → ℝ × ℝ :=
  colemanPrices V T hγ hLbox hβR z (kBox V T hγ hLbox hβR k)

/-- The household's value at `(z, K, a, e)`. -/
noncomputable def valueR (z : Z) (k : ℝ) (a : ↥(Icc (0 : ℝ) (𝕄).assetCap)) (e : E) : ℝ :=
  ((𝕄).household z (pricesK V T hγ hLbox hβR z k)).valueFunction (a, ⟨e, []⟩)

/-- The household's saving at `(z, K, a, e)`. -/
noncomputable def savingR (z : Z) (k : ℝ) (a : ↥(Icc (0 : ℝ) (𝕄).assetCap)) (e : E) :
    ↥(Icc (0 : ℝ) (𝕄).assetCap) :=
  ⟨(𝕄).policy z (pricesK V T hγ hLbox hβR z k) (a, ⟨e, []⟩), (𝕄).policy_mem_Icc _ _ _⟩

/-- The law of motion of capital: the Coleman saving. -/
noncomputable def lawKR (z : Z) (k : ℝ) (_z' : Z) : ℝ :=
  (𝒟).saving 𝒸 z (kBox V T hγ hLbox hβR k)

theorem lawKR_mem (z : Z) (k : ℝ) (z' : Z) : lawKR V T hγ hLbox hβR z k z' ∈ Icc 0 V.assetCap :=
  ⟨((𝒟).saving_spec 𝒸 z _).1, ((𝒟).saving_spec 𝒸 z _).2.1⟩

/-- **From the next node the prices are those of the Coleman path from `(z', s*(z, K))`.** -/
theorem shiftPath_pricesK (z : Z) (k : ℝ) (z' : Z) :
    shiftPath (pricesK V T hγ hLbox hβR z k) [z']
      = pricesK V T hγ hLbox hβR z' (lawKR V T hγ hLbox hβR z k z') := by
  funext g
  simp only [shiftPath_apply, pricesK, colemanPrices, lawKR]
  rw [Data.capPath_append]
  change (((𝒟).capPath 𝒸 z' ((𝒟).savingBox 𝒸 z (kBox V T hγ hLbox hβR k)) g : ℝ),
      V.efficiency default) = _
  rw [show (𝒟).saving 𝒸 z (kBox V T hγ hLbox hβR k)
      = (((𝒟).savingBox 𝒸 z (kBox V T hγ hLbox hβR k) : (𝒟).Box) : ℝ) from rfl,
    kBox_coe]

/-- **Continuation values are the values at the next aggregate state.** -/
theorem valueFunction_next (z : Z) (k : ℝ) (z' : Z) (a : ↥(Icc (0 : ℝ) (𝕄).assetCap)) (e' : E) :
    ((𝕄).household z (pricesK V T hγ hLbox hβR z k)).valueFunction (a, ⟨e', [z']⟩)
      = valueR V T hγ hLbox hβR z' (lawKR V T hγ hLbox hβR z k z') a e' := by
  rw [valueR, ← shiftPath_pricesK]
  have h := DFunLike.congr_fun
    ((𝕄).valueFunction_shift z (pricesK V T hγ hLbox hβR z k) [z']) (a, ⟨e', []⟩)
  exact h.symm

/-- Cash at the root of `(z, K)`. -/
theorem cash_root {z : Z} {k : ℝ} (hk : k ∈ Icc 0 V.assetCap)
    (a : ↥(Icc (0 : ℝ) (𝕄).assetCap)) (e : E) :
    (𝕄).cash z (pricesK V T hγ hLbox hβR z k) (a, ⟨e, []⟩)
      = (𝕄).grossReturn z k (V.efficiency default) * a
        + (𝕄).wage z k (V.efficiency default) * (𝕄).efficiency e
        - (𝕄).grossReturn z k (V.efficiency default) * (𝕄).borrowLimit := by
  change (𝕄).grossReturn z ((kBox V T hγ hLbox hβR k : (𝒟).Box) : ℝ) (V.efficiency default) * a
      + (𝕄).wage z ((kBox V T hγ hLbox hβR k : (𝒟).Box) : ℝ) (V.efficiency default)
        * (𝕄).efficiency e
      - (𝕄).grossReturn z ((kBox V T hγ hLbox hβR k : (𝒟).Box) : ℝ) (V.efficiency default)
        * (𝕄).borrowLimit = _
  rw [kBox_val V T hγ hLbox hβR hk]

/-- The representative household at `K` saves the Coleman saving. -/
theorem savingR_root {z : Z} {k : ℝ} (hk : k ∈ Icc 0 V.assetCap) :
    ((savingR V T hγ hLbox hβR z k ⟨k, hk⟩ default : ↥(Icc (0 : ℝ) (𝕄).assetCap)) : ℝ)
      = lawKR V T hγ hLbox hβR z k z := by
  have hroot : rootOf V T hγ hLbox hβR (kBox V T hγ hLbox hβR k)
      = ((⟨k, hk⟩ : ↥(Icc (0 : ℝ) (𝕄).assetCap)), (⟨default, []⟩ : Label Z E)) :=
    Prod.ext (Subtype.ext (kBox_val V T hγ hLbox hβR hk)) rfl
  have := policy_eq_saving V T hγ hLbox hβR z (kBox V T hγ hLbox hβR k)
  rw [hroot] at this
  exact this

/-- **A recursive equilibrium on `(z, K)`** for the representative-agent CRRA, Cobb–Douglas
economy with `β R̄ ≤ 1`, at every capital share. -/
noncomputable def colemanRecursive : (𝕄).AggStateRecursiveEquilibrium where
  Kset _ := Icc 0 V.assetCap
  lawK := lawKR V T hγ hLbox hβR
  labourK _ _ := V.efficiency default
  value := valueR V T hγ hLbox hβR
  saving := savingR V T hγ hLbox hβR
  dist _ k := {ν | ∃ hk : k ∈ Icc 0 V.assetCap,
    ν = diracProba (((⟨k, hk⟩ : ↥(Icc (0 : ℝ) (𝕄).assetCap)), (⟨default⟩ : Idio E)))}
  lawK_mem z k _ z' := lawKR_mem V T hγ hLbox hβR z k z'
  dist_nonempty _ k hk := ⟨_, hk, rfl⟩
  capital_eq _ k ν hν := by
    obtain ⟨hk, rfl⟩ := hν
    change ∫ x, (𝕄).assets x ∂(Measure.dirac _) = k
    rw [integral_dirac]
    rfl
  labour_eq _ k ν hν := by
    obtain ⟨hk, rfl⟩ := hν
    change V.efficiency default
      = ∑ e, (𝕄).initMass (Measure.dirac _) e * (𝕄).efficiency e
    rw [Fintype.sum_unique, (𝕄).initMass_dirac, one_mul]
    rfl
  feasible z k hk a e := by
    have h := (𝕄).policy_mem z (pricesK V T hγ hLbox hβR z k) (a, ⟨e, []⟩)
    have h2 := h.2.trans (min_le_right _ _)
    change (𝕄).policy z (pricesK V T hγ hLbox hβR z k) (a, ⟨e, []⟩) ≤ _
    rw [← cash_root V T hγ hLbox hβR hk a e]
    linarith
  bellman z k hk a e := by
    set D := (𝕄).household z (pricesK V T hγ hLbox hβR z k)
    have hV : D.valueFunction (a, ⟨e, []⟩) = D.bellman D.valueFunction (a, ⟨e, []⟩) := by
      rw [D.bellman_valueFunction]
    rw [valueR, hV, (𝕄).policy_optimal z, (𝕄).objective_eq z _ _ ((𝕄).policy_mem z _ _),
      cash_root V T hγ hLbox hβR hk]
    congr 2
    refine Finset.sum_congr rfl fun ze _ => ?_
    rw [(𝕄).clampAssets_of_mem ((𝕄).policy_mem_Icc z _ _), valueFunction_next]
    rfl
  optimal z k hk a e a' ha' := by
    set D := (𝕄).household z (pricesK V T hγ hLbox hβR z k)
    have hfeas : (a' : ℝ) ∈ D.feasible (a, ⟨e, []⟩) := by
      refine ⟨a'.2.1, le_min a'.2.2 ?_⟩
      rw [cash_root V T hγ hLbox hβR hk]
      linarith
    have hle := D.le_bellmanFn D.valueFunction hfeas
    have hV : D.bellmanFn D.valueFunction (a, ⟨e, []⟩) = D.valueFunction (a, ⟨e, []⟩) :=
      congrFun (congrArg DFunLike.coe D.bellman_valueFunction) _
    rw [hV, (𝕄).objective_eq z _ _ hfeas, cash_root V T hγ hLbox hβR hk] at hle
    refine le_of_eq_of_le ?_ hle
    congr 2
    refine Finset.sum_congr rfl fun ze _ => ?_
    rw [(𝕄).clampAssets_of_mem a'.2, valueFunction_next]
    rfl
  lawOfMotion z k ν hν z' := by
    obtain ⟨hk, rfl⟩ := hν
    refine ⟨diracProba (((⟨lawKR V T hγ hLbox hβR z k z', lawKR_mem V T hγ hLbox hβR z k z'⟩ :
        ↥(Icc (0 : ℝ) (𝕄).assetCap)), (⟨default⟩ : Idio E))),
      ⟨lawKR_mem V T hγ hLbox hβR z k z', rfl⟩, fun f => ?_⟩
    change ∫ x, f x ∂(Measure.dirac _) = ∫ x, _ ∂(Measure.dirac _)
    rw [integral_dirac, integral_dirac, Fintype.sum_unique]
    have hidio : (𝕄).idioProb z z' default default = 1 := by
      have := (𝕄).idioProb_sum z z' default
      rwa [Fintype.sum_unique] at this
    have hs : savingR V T hγ hLbox hβR z k ⟨k, hk⟩ default
        = ⟨lawKR V T hγ hLbox hβR z k z', lawKR_mem V T hγ hLbox hβR z k z'⟩ :=
      Subtype.ext (savingR_root V T hγ hLbox hβR hk)
    change f _ = (𝕄).idioProb z z' default default
      * f (savingR V T hγ hLbox hβR z k ⟨k, hk⟩ default, ⟨default⟩)
    rw [hidio, one_mul, hs]

/-- **The sequential equilibrium of CO4d is generated by the recursive law of motion**: capital
at `z' :: h` is `lawK` at the node's shock and capital. -/
theorem capPath_eq_lawK (z₀ : Z) (k₀ : (𝒟).Box) (h : List Z) (z' : Z) :
    ((𝒟).capPath 𝒸 z₀ k₀ (z' :: h) : ℝ)
      = (colemanRecursive V T hγ hLbox hβR).lawK (shockAt z₀ h) ((𝒟).capPath 𝒸 z₀ k₀ h) z' := by
  change (𝒟).saving 𝒸 (h.headD z₀) ((𝒟).capPath 𝒸 z₀ k₀ h)
    = (𝒟).saving 𝒸 (shockAt z₀ h) (kBox V T hγ hLbox hβR ((𝒟).capPath 𝒸 z₀ k₀ h : ℝ))
  rw [kBox_coe]
  rfl

end Coleman

end KrusellSmith

end LeanEconomics
