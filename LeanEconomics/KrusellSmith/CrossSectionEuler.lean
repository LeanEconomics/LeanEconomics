import LeanEconomics.KrusellSmith.ColemanSufficiency
import LeanEconomics.KrusellSmith.Equilibrium
import LeanEconomics.KrusellSmith.CRRAContraction

/-!
# The Euler system on whole cross-sections

The heterogeneous-household analogue of the Coleman fixed point (`CROSS_SECTION_PLAN.md`).

For the representative agent the Coleman operator acts on a policy `c(z, k)` and its fixed point is
an equilibrium because own saving *is* aggregate saving. With heterogeneous households the unknown
is a **saving rule on the whole cross-section**, `σ(a, e, h)` at every node `h` of the tree, and
the operator has two legs:

* *household leg*: given the price path, `σ` solves every household's Euler conditions with the
  corners (`IsEulerRule`);
* *aggregation leg*: the price path is the one generated by `σ` itself — capital at node `h` is
  mean assets of the distribution `σ` generates from `μ₀` (`ruleDist`).

A pair `(K, σ)` satisfying both is a **cross-section Euler equilibrium**
(`IsCrossSectionEquilibrium`): a fixed point of the cross-section operator.

* **`policy_eq_of_eulerRule`** (verification, any `KSModel` without borrowing): an Euler rule with
  bounded marginal utility is the household's optimal policy at *every* state `(a, e, h)` — Euler
  sufficiency (`policy_eq_of_euler`) applied to the plan that follows the rule (`rulePlan`).
* **`IsCrossSectionEquilibrium.isSequentialEquilibrium`**: a cross-section Euler equilibrium is a
  sequential equilibrium.
* **`isCrossSectionEquilibrium_of_sequential`**: conversely, when optimal consumption is bounded
  away from the floor, the policy of a sequential equilibrium is a cross-section Euler equilibrium
  (Euler necessity, `euler_le`/`euler_ge`).
* **`crra_isSequentialEquilibrium_iff`**, **`crra_exists_crossSectionEquilibrium`**: for CRRA
  utility the two notions coincide, so a fixed point of the cross-section operator **exists from
  every initial distribution, at every capital share** — by Schauder–Tychonoff
  (`exists_sequentialEquilibrium`), *not* by an order argument.

What stays open is the order structure: the household leg is monotone in next period's policy,
but the aggregation leg moves prices, and a price change redistributes cash across the
cross-section (`CobbDouglas.integral_redistribution_eq_zero`: the changes sum to zero, so they
have both signs unless the cross-section is a point). No pointwise order on rules is preserved,
Tarski does not apply, and no recursive structure on `(z, μ)` comes out.
-/

open Set Filter Topology MeasureTheory
open LeanEconomics.StochasticDynamicProgram
open scoped ENNReal NNReal

namespace LeanEconomics

namespace KrusellSmith

variable {Z E : Type*} [Fintype Z] [Fintype E]

namespace KSModel

variable {M : KSModel Z E} (z₀ : Z) (P : List Z → ℝ × ℝ) (U : M.SmoothUtility)

/-! ### The household leg: Euler rules -/

/-- Consumption under a saving rule. -/
noncomputable def ruleCons (σ : M.State → ℝ) (s : M.State) : ℝ := M.cash z₀ P s - σ s

/-- The return-weighted expected marginal utility of next period's consumption under a saving
rule: the right-hand side of the Euler equation, before discounting. -/
noncomputable def ruleRhs (σ : M.State → ℝ) (s : M.State) : ℝ :=
  ∑ ze : Z × E, M.shockProb z₀ ze (s, σ s) * M.returnAt z₀ P (ze.1 :: s.2.node)
    * U.du (ruleCons z₀ P σ (M.stateAt (σ s) ⟨ze.2, ze.1 :: s.2.node⟩))

/-- **An Euler rule**: a feasible saving rule on all household states of the tree, with
consumption above the floor, satisfying the Euler conditions with the corners at zero saving and
at the cap. -/
structure IsEulerRule (σ : M.State → ℝ) : Prop where
  mem : ∀ s, σ s ∈ (M.household z₀ P).feasible s
  slack : ∀ s, M.consFloor < ruleCons z₀ P σ s
  le : ∀ s, 0 < σ s → U.du (ruleCons z₀ P σ s) ≤ M.discount * ruleRhs z₀ P U σ s
  ge : ∀ s, σ s < M.assetCap → M.discount * ruleRhs z₀ P U σ s ≤ U.du (ruleCons z₀ P σ s)

/-- The state reached by following a saving rule along a history. -/
noncomputable def ruleState (σ : M.State → ℝ) (s₀ : M.State) : ∀ n : ℕ, (Fin n → Z × E) → M.State
  | 0, _ => s₀
  | n + 1, h => M.transition (h (Fin.last n))
      (ruleState σ s₀ n (Fin.init h), σ (ruleState σ s₀ n (Fin.init h)))

theorem ruleState_snoc (σ : M.State → ℝ) (s₀ : M.State) (n : ℕ) (h : Fin n → Z × E)
    (ze : Z × E) :
    ruleState σ s₀ (n + 1) (Fin.snoc h ze)
      = M.transition ze (ruleState σ s₀ n h, σ (ruleState σ s₀ n h)) := by
  simp only [ruleState, Fin.init_snoc, Fin.snoc_last]

/-- **The plan that follows a saving rule.** -/
noncomputable def rulePlan {σ : M.State → ℝ} (hσ : ∀ s, σ s ∈ (M.household z₀ P).feasible s)
    (s₀ : M.State) : (M.household z₀ P).Plan s₀ where
  state := ruleState σ s₀
  action n h := σ (ruleState σ s₀ n h)
  state_zero _ := rfl
  action_mem _ _ := hσ _
  state_succ n h ze := ruleState_snoc σ s₀ n h ze

theorem rulePlan_nextMU {σ : M.State → ℝ} (hσ : ∀ s, σ s ∈ (M.household z₀ P).feasible s)
    (s₀ : M.State) (n : ℕ) (h : Fin n → Z × E) :
    nextMU z₀ P U (rulePlan z₀ P hσ s₀) n h = ruleRhs z₀ P U σ (ruleState σ s₀ n h) := by
  rw [nextMU, ruleRhs]
  refine Finset.sum_congr rfl fun ze _ => ?_
  have h1 : (labelOf s₀.2 n h).node = (ruleState σ s₀ n h).2.node := by
    rw [← plan_label z₀ P (rulePlan z₀ P hσ s₀) n h]
    rfl
  have h2 : planCons z₀ P (rulePlan z₀ P hσ s₀) (n + 1) (Fin.snoc h ze)
      = ruleCons z₀ P σ (M.stateAt (σ (ruleState σ s₀ n h))
        ⟨ze.2, ze.1 :: (ruleState σ s₀ n h).2.node⟩) := by
    change M.cash z₀ P (ruleState σ s₀ (n + 1) (Fin.snoc h ze))
      - σ (ruleState σ s₀ (n + 1) (Fin.snoc h ze)) = _
    rw [ruleState_snoc]
    rfl
  rw [h1, h2, ← mul_assoc]
  rfl

/-- **The plan that follows an Euler rule satisfies the Euler conditions**, from every state. -/
theorem rulePlan_euler {σ : M.State → ℝ} (hσ : IsEulerRule z₀ P U σ) (s₀ : M.State) :
    PlanEuler z₀ P U (rulePlan z₀ P hσ.mem s₀) := by
  intro n h
  rw [rulePlan_nextMU z₀ P U hσ.mem s₀ n h]
  exact ⟨hσ.slack _, hσ.le _, hσ.ge _⟩

/-- **Verification on the cross-section**: an Euler rule with bounded marginal utility is the
household's optimal policy at every state of the tree. -/
theorem policy_eq_of_eulerRule (hb : M.borrowLimit = 0) {σ : M.State → ℝ}
    (hσ : IsEulerRule z₀ P U σ) {Dbar : ℝ} (hD : ∀ s, U.du (ruleCons z₀ P σ s) ≤ Dbar)
    (s : M.State) : M.policy z₀ P s = σ s :=
  policy_eq_of_euler z₀ P U hb (rulePlan_euler z₀ P U hσ s) (fun _ _ => hD _) Fin.elim0

/-! ### The aggregation leg: the distributions a rule generates -/

variable (μ₀ : Measure M.AState)

/-- A household at `x` at node `h`, saving by the rule `σ`, moves to `e'`. -/
noncomputable def ruleNextA (σ : M.State → ℝ) (h : List Z) (e' : E) (x : M.AState) : M.AState :=
  (M.clampAssets (σ (x.1, ⟨x.2.idio, h⟩)), ⟨e'⟩)

/-- One step down the tree under the rule `σ`. -/
noncomputable def rulePush (σ : M.State → ℝ) (h : List Z) (z' : Z) (μ : Measure M.AState) :
    Measure M.AState :=
  Measure.sum fun e' : E =>
    (μ.withDensity fun x => (M.dens z₀ h z' e' x : ℝ≥0∞)).map (ruleNextA σ h e')

/-- **The cross-sections a saving rule generates** from `μ₀`, at every node. -/
noncomputable def ruleDist (σ : M.State → ℝ) : List Z → Measure M.AState
  | [] => μ₀
  | z' :: h => rulePush z₀ σ h z' (ruleDist σ h)

/-- A rule that is the household's policy generates the equilibrium cross-sections. -/
theorem ruleDist_eq_nodeDist {σ : M.State → ℝ} (hσ : ∀ s, M.policy z₀ P s = σ s) :
    ∀ h, ruleDist z₀ μ₀ σ h = M.nodeDist z₀ μ₀ P h
  | [] => rfl
  | z' :: h => by
    change rulePush z₀ σ h z' (ruleDist z₀ μ₀ σ h) = M.pushNode z₀ P h z' (M.nodeDist z₀ μ₀ P h)
    rw [ruleDist_eq_nodeDist hσ h]
    have hA : ∀ e', ruleNextA σ h e' = M.nextA z₀ P h e' := fun e' => funext fun x => by
      simp only [ruleNextA, nextA, hσ]
    simp only [rulePush, pushNode, hA]

/-! ### Cross-section Euler equilibrium -/

/-- **A cross-section Euler equilibrium**: a capital path and a saving rule on the whole
cross-section such that the rule solves every household's Euler conditions at the prices of the
path (with marginal utility bounded), and the path is mean assets of the cross-sections the rule
generates. A fixed point of the cross-section Coleman operator. -/
structure IsCrossSectionEquilibrium (K : List Z → ℝ) (σ : M.State → ℝ) : Prop where
  euler : IsEulerRule z₀ (M.pricePath z₀ (M.initMass μ₀) K) U σ
  bound : ∃ Dbar : ℝ, ∀ s, U.du (ruleCons z₀ (M.pricePath z₀ (M.initMass μ₀) K) σ s) ≤ Dbar
  capital : ∀ h, K h = ∫ x, M.assets x ∂(ruleDist z₀ μ₀ σ h)

variable {U μ₀}

/-- In a cross-section Euler equilibrium the rule is every household's optimal policy. -/
theorem IsCrossSectionEquilibrium.policy_eq (hb : M.borrowLimit = 0) {K : List Z → ℝ}
    {σ : M.State → ℝ} (hE : IsCrossSectionEquilibrium z₀ U μ₀ K σ) (s : M.State) :
    M.policy z₀ (M.pricePath z₀ (M.initMass μ₀) K) s = σ s := by
  obtain ⟨Dbar, hD⟩ := hE.bound
  exact policy_eq_of_eulerRule z₀ _ U hb hE.euler hD s

/-- **A cross-section Euler equilibrium is a sequential equilibrium.** -/
theorem IsCrossSectionEquilibrium.isSequentialEquilibrium (hb : M.borrowLimit = 0)
    {K : List Z → ℝ} {σ : M.State → ℝ} (hE : IsCrossSectionEquilibrium z₀ U μ₀ K σ) :
    M.IsSequentialEquilibrium z₀ μ₀ K := by
  intro h
  rw [hE.capital h, ruleDist_eq_nodeDist z₀ _ μ₀ (hE.policy_eq z₀ hb) h]
  rfl

/-- **A sequential equilibrium is a cross-section Euler equilibrium**, with the household's
policy as the rule, when optimal consumption is bounded away from the floor. -/
theorem isCrossSectionEquilibrium_of_sequential {K : List Z → ℝ} {m : ℝ}
    (hm : M.consFloor < m)
    (hc : ∀ s, m ≤ M.consumption z₀ (M.pricePath z₀ (M.initMass μ₀) K) s)
    (hK : M.IsSequentialEquilibrium z₀ μ₀ K) :
    IsCrossSectionEquilibrium z₀ U μ₀ K (M.policy z₀ (M.pricePath z₀ (M.initMass μ₀) K)) := by
  have hsl : M.Slack z₀ (M.pricePath z₀ (M.initMass μ₀) K) := fun s => hm.trans_le (hc s)
  refine ⟨⟨fun s => M.policy_mem z₀ _ s, hsl, fun s hpos => ?_, fun s hcap => ?_⟩,
    ⟨U.du m, fun s => U.du_anti hm (hc s)⟩, fun h => ?_⟩
  · exact M.euler_le U z₀ _ hsl s hpos
  · exact M.euler_ge U z₀ _ hsl s hcap
  · rw [hK h, ruleDist_eq_nodeDist z₀ _ μ₀ (fun _ => rfl) h]
    rfl

end KSModel

/-! ### CRRA: the fixed point of the cross-section operator exists at every share -/

variable (V : KSEnvironment Z E) (T : CobbDouglas Z) {γ : ℝ} (hγ : 0 < γ)

/-- **For CRRA utility, sequential equilibria are exactly the cross-section Euler equilibria.** -/
theorem crra_isSequentialEquilibrium_iff (z₀ : Z) (μ₀ : Measure (crraModel V T hγ).AState)
    (K : List Z → ℝ) :
    (crraModel V T hγ).IsSequentialEquilibrium z₀ μ₀ K
      ↔ ∃ σ, KSModel.IsCrossSectionEquilibrium z₀ (crraSmoothUtility V T hγ) μ₀ K σ := by
  constructor
  · intro hK
    exact ⟨_, KSModel.isCrossSectionEquilibrium_of_sequential z₀
      (half_lt_self (crraFloorLevel_pos V T hγ))
      (crraFloorLevel_le_consumption V T hγ z₀ _) hK⟩
  · rintro ⟨σ, hE⟩
    exact hE.isSequentialEquilibrium z₀ rfl

/-- **A cross-section Euler equilibrium exists** for CRRA utility, from every initial shock and
every initial distribution of heterogeneous households, at every capital share. -/
theorem crra_exists_crossSectionEquilibrium (z₀ : Z) (μ₀ : Measure (crraModel V T hγ).AState)
    [IsProbabilityMeasure μ₀] :
    ∃ K ∈ (crraModel V T hγ).capitalPaths ((crraModel V T hγ).initCapital μ₀),
      ∃ σ, KSModel.IsCrossSectionEquilibrium z₀ (crraSmoothUtility V T hγ) μ₀ K σ := by
  obtain ⟨K, hK, hEq⟩ := (crraModel V T hγ).exists_sequentialEquilibrium z₀ μ₀
  exact ⟨K, hK, (crra_isSequentialEquilibrium_iff V T hγ z₀ μ₀ K).1 hEq⟩

end KrusellSmith

end LeanEconomics
