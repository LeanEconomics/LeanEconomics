import LeanEconomics.KrusellSmith.ValueStateGlue
import LeanEconomics.KrusellSmith.Inada

/-!
# Existence of recursive equilibrium with the value function as a state variable

Milestone V4 of `VALUESTATE_PLAN.md`: the main theorems, with no uniqueness hypothesis.

* `recursiveEquilibrium_valueState` (Cao 2020, Proposition 3): on the extended states
  `(z, μ, v)`, which exist over every `(z, μ)`, the policy `ExtState.policy` and the transition
  `ExtState.next` satisfy the period equilibrium conditions: prices depend on `(z, μ)` alone,
  households save optimally against next period's values, distributions move by the policy, and
  idiosyncratic masses by `idioProb`.
* `generates_sequentialEquilibrium` (Miao 2006, Theorem 2): from every extended state, the
  recursive equilibrium generates a sequential equilibrium, in which households' values,
  policies and distributions at every node are those of the extended state there.
* `payoffEquivalent` (Miao 2006, Theorem 3): every sequential equilibrium has a payoff-equivalent
  one generated by the recursive equilibrium: same initial state, same households' values.
* `gluedPath_eq_eqPath`, `tree_dist_eq_nodeProb`: under uniqueness of sequential equilibrium the
  generated equilibrium is the equilibrium path, and the extended state carries no more than the
  minimal state of `Recursive.lean`.
* `KSInada.generates_sequentialEquilibrium`: for log and CRRA utility (`KSInada`, which includes
  `logEconomy` and `crraEconomy` with clamped Cobb–Douglas prices), the generated equilibrium of
  the floored economy is an equilibrium of the original one: households' saving is optimal among
  all savings with positive consumption.

Not shown: measurability of the selection (Miao asks for it; Cao's Definition 5 does not), and
stationarity (Cao §6, via Duffie–Geanakoplos–Mas-Colell–McLennan 1994).
-/

open Set Filter Topology BoundedContinuousFunction MeasureTheory

namespace LeanEconomics

namespace KrusellSmith

variable {Z E : Type*} [Fintype Z] [Fintype E]

namespace KSModel

variable (M : KSModel Z E)

/-- **Existence of recursive equilibrium with the value function as a state variable.** Every
aggregate shock and distribution extend to an extended state, and at every extended state
`ξ = (z, μ, v)` the policy `ξ.policy` and the next states `ξ.next z'` satisfy:
cash on hand depends on `(z, μ)` alone (capital is mean assets of `μ`, labour its
efficiency-weighted mass); `v` is the value of saving optimally against the next states' values,
attained by the policy; the next distribution is `μ` pushed forward by the policy; and
idiosyncratic masses move by `idioProb`. -/
theorem recursiveEquilibrium_valueState :
    (∀ (z : Z) (μ : ProbabilityMeasure M.AState),
      ∃ ξ : M.ExtState, ξ.shock = z ∧ ξ.dist = μ) ∧
    ∀ ξ : M.ExtState,
      (∀ x, ξ.cash x = M.grossReturn ξ.shock ξ.capital ξ.labour * x.1
        + M.wage ξ.shock ξ.capital ξ.labour * M.efficiency x.2.idio) ∧
      (∀ x, ξ.policy x ∈ Icc 0 (ξ.maxSaving x) ∧ ξ.value x = ξ.objective x (ξ.policy x) ∧
        ∀ a ∈ Icc 0 (ξ.maxSaving x), ξ.objective x a ≤ ξ.value x) ∧
      (∀ z', ((ξ.next z').dist : Measure M.AState)
        = M.pushNode ξ.shock ξ.prices [] z' (ξ.dist : Measure M.AState)) ∧
      (∀ e' x, M.nextA ξ.shock ξ.prices [] e' x = (M.clampAssets (ξ.policy x), ⟨e'⟩)) ∧
      ∀ z' e', M.initMass ((ξ.next z').dist : Measure M.AState) e'
        = ∑ e, M.initMass (ξ.dist : Measure M.AState) e * M.idioProb ξ.shock z' e e' :=
  ⟨fun z μ => ⟨ExtState.extend M z μ, rfl, rfl⟩, fun ξ =>
    ⟨ξ.cash_eq, fun x => ⟨ξ.policy_mem x, ξ.value_eq x, fun _ ha => ξ.objective_le_value x ha⟩,
      ξ.next_dist_eq, ξ.nextA_nil, ξ.initMass_next⟩⟩

variable {M}

/-- **The recursive equilibrium generates sequential equilibria.** From every extended state
`ξ₀`, the glued path is a sequential equilibrium from `(z₀, μ₀)`; at every node `h` the extended
state has the shock of `h`, and households' value, saving and distribution there are those of the
extended state. -/
theorem generates_sequentialEquilibrium (ξ₀ : M.ExtState) :
    M.IsSequentialEquilibrium ξ₀.shock (ξ₀.dist : Measure M.AState) ξ₀.gluedPath ∧
      ∀ h : List Z, (ξ₀.tree h).shock = shockAt ξ₀.shock h ∧
        M.nodeValue ξ₀.shock (ξ₀.dist : Measure M.AState) ξ₀.gluedPath h = (ξ₀.tree h).value ∧
        (∀ x : M.AState,
          M.policy ξ₀.shock ξ₀.gluedPrices (x.1, ⟨x.2.idio, h⟩) = (ξ₀.tree h).policy x) ∧
        M.nodeDist ξ₀.shock (ξ₀.dist : Measure M.AState) ξ₀.gluedPrices h
          = ((ξ₀.tree h).dist : Measure M.AState) :=
  ⟨ξ₀.isSequentialEquilibrium_glued, fun h =>
    ⟨ξ₀.tree_shock h, ξ₀.nodeValue_glued h, fun x => ξ₀.policy_glued (x.1, ⟨x.2.idio, h⟩),
      ξ₀.nodeDist_glued h⟩⟩

/-- **Payoff equivalence.** Every sequential equilibrium `K` from `(z, μ)` has a payoff-equivalent
sequential equilibrium generated by the recursive equilibrium: started at the extended state
`(z, μ, v)` with `v` the households' value along `K`, it gives households the same value. -/
theorem payoffEquivalent {z : Z} {μ : ProbabilityMeasure M.AState} {K : List Z → ℝ}
    (hK : M.IsSequentialEquilibrium z (μ : Measure M.AState) K) :
    ∃ ξ : M.ExtState, ξ.shock = z ∧ ξ.dist = μ ∧
      ξ.value = M.rootValue z (μ : Measure M.AState) K ∧
      M.IsSequentialEquilibrium z (μ : Measure M.AState) ξ.gluedPath ∧
      M.rootValue z (μ : Measure M.AState) ξ.gluedPath = M.rootValue z (μ : Measure M.AState) K :=
  let ξ : M.ExtState := ⟨z, μ, M.rootValue z (μ : Measure M.AState) K, K, hK, rfl⟩
  ⟨ξ, rfl, rfl, rfl, ξ.isSequentialEquilibrium_glued, ξ.rootValue_glued⟩

/-- **Under uniqueness, the generated equilibrium is the equilibrium path.** -/
theorem ExtState.gluedPath_eq_eqPath (hU : M.UniqueSequentialEquilibrium) (ξ₀ : M.ExtState) :
    ξ₀.gluedPath = M.eqPath ξ₀.shock ξ₀.dist :=
  hU.eq_eqPath ξ₀.isSequentialEquilibrium_glued

/-- **Under uniqueness, the extended states along the tree carry the minimal state**: their
distributions are those of the equilibrium path. -/
theorem ExtState.tree_dist_eq_nodeProb (hU : M.UniqueSequentialEquilibrium) (ξ₀ : M.ExtState)
    (h : List Z) : (ξ₀.tree h).dist = M.nodeProb ξ₀.shock ξ₀.dist h := by
  apply Subtype.ext
  change ((ξ₀.tree h).dist : Measure M.AState)
    = M.nodeDist ξ₀.shock (ξ₀.dist : Measure M.AState)
      (M.pricePath ξ₀.shock (M.initMass (ξ₀.dist : Measure M.AState))
        (M.eqPath ξ₀.shock ξ₀.dist)) h
  rw [← ξ₀.gluedPath_eq_eqPath hU]
  exact (ξ₀.nodeDist_glued h).symm

end KSModel

namespace KSInada

variable (P : KSInada Z E)

/-- **Recursive equilibrium with the value function as a state variable, for log and CRRA
utility.** For a Krusell–Smith economy with utility unbounded below (`KSInada`: log, CRRA with
any `γ > 0`, with `logEconomy` and `crraEconomy` as instances), from every extended state of the
floored economy the recursive equilibrium generates a sequential equilibrium in which every
household's saving is optimal among **all** savings with positive consumption, and consumption
is at least `floorLevel`. -/
theorem generates_sequentialEquilibrium (ξ₀ : P.floored.ExtState) :
    P.floored.IsSequentialEquilibrium ξ₀.shock (ξ₀.dist : Measure P.floored.AState)
        ξ₀.gluedPath ∧
      ∀ s : P.floored.State,
        P.floorLevel ≤ P.floored.cash ξ₀.shock ξ₀.gluedPrices s
            - P.floored.policy ξ₀.shock ξ₀.gluedPrices s ∧
        ∀ a, 0 ≤ a → a ≤ P.assetCap → a < P.floored.cash ξ₀.shock ξ₀.gluedPrices s →
          P.utility (P.floored.cash ξ₀.shock ξ₀.gluedPrices s - a)
              + P.discount * P.cont P.floor_pos P.floor_le_incomeFloor ξ₀.shock
                  ξ₀.gluedPrices s a
            ≤ (P.floored.household ξ₀.shock ξ₀.gluedPrices).valueFunction s :=
  ⟨ξ₀.isSequentialEquilibrium_glued, fun s =>
    ⟨P.floorLevel_le_consumption P.floor_pos P.floor_le_incomeFloor ξ₀.shock _ s,
      fun _ ha0 haA hac => P.objective_le_valueFunction P.floor_pos P.floor_le_incomeFloor
        ξ₀.shock _ P.floor_lt_floorLevel s ha0 haA hac⟩⟩

end KSInada

end KrusellSmith

end LeanEconomics
